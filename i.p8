__lua__
function onDown(k, f)
  if btn(k) then
    f()
  end
end

function onClick(k, f)
  if btnp(k) then
    f()
  end
end

function collide(o, sd, f)
  local tx = flr(o.x / 8) + (sd.mapX * 16)
  local ty = flr(o.y / 8) + (sd.mapY * 16)
  local tw = flr((o.x + o.w * 8 - 1) / 8) + (sd.mapX * 16)
  local th = flr((o.y + o.h * 8 - 1) / 8) + (sd.mapY * 16)

  return fget(mget(tx, ty), f)
      or fget(mget(tw, ty), f)
      or fget(mget(tx, th), f)
      or fget(mget(tw, th), f)
end

function trail(o, sd)
	local tx = flr(o.x / 8) + (sd.mapX * 16)
  local ty = flr(o.y / 8) + (sd.mapY * 16)
  local tw = flr((o.x + o.w * 8 - 1) / 8) + (sd.mapX * 16)
  local th = flr((o.y + o.h * 8 - 1) / 8) + (sd.mapY * 16)

	local touching = (tx <= o.old.x and tw >= o.old.x and ty <= o.old.y and th >= o.old.y)

	if not touching then
		mset(o.old.x, o.old.y, 6)
		o.old.x = flr((o.x + (o.w / 2)) / 8) + (sd.mapX * 16)
		o.old.y = flr((o.y + (o.h / 2)) / 8) + (sd.mapY * 16)
	end
end

function delTrail()
	for x = 0, 15 do
		for y = 0, 15 do
			local tx = sd.mapX * 16 + x
      local ty = sd.mapY * 16 + y
			local m = mget(tx, ty)
			if m == 6 then
				mset(tx, ty, 0)
			end
		end
	end
end

