sceneManager = {
	l1 = {
		init = function()
			sd = {
  			mapX = 0,
  			mapY = 0,
				next = "l2"
			}

			plr = {
				spr = 17,
				grounded = false,

				old = {
					x = 0, y = 64  
				},

				x = 0, y = 64,
				w = 1, h = 1,
				dx = 0, dy = 0,
				ax = 0.5, ay = 4,
				mdx = 2.5, mdy = 4,
				fx = false, fy = false,

				animState = "idle",
				animIndex = 1,

				anims = {
					idle = {
						sprs = { 17, 17, 17, 17, 17, 17, 17, 17, 17, 17, 17, 17, 
										 18, 18, 18, 18, 18, 18, 18, 18, 18, 18, 18, 18,  }
					},
					walk = {
						sprs = { 19, 19, 19, 19, 19, 19, 
										 20, 20, 20, 20, 20, 20 }
					},
					jumpUp = {
						sprs = { 21 }
					},
					jumpDown = {
						sprs = { 22 }
					}
				}
			}
			
			glb = {
				gr = 0.5,
				fr = 0.75
			}
			coins = coinDetection()
 end,
		update = function()
			playerUpdate()
		end,
		
		draw = function() 
			levelDraw()
			print("Walk with <-->", 30, 66, 8)
		end,

		transition = false,
		transitionFun = function() end
	},
	l2 = {
		init = function()
			sd = {
  			mapX = 1,
  			mapY = 0,
				next = "l1"
			}

			plr = {
				spr = 17,
				grounded = false,

				old = {
					x = 16, y = 64  
