function playerUpdate()
			onClick(4, function ()
				if plr.grounded then 
					plr.dy -= plr.ay
					plr.grounded = false
					sfx(1)
				end
			end)

			local tb = 0
      local bb = 128 - (plr.h * 8)

			plr.dy += glb.gr

			plr.dy = mid(-plr.mdy, plr.dy, plr.mdy)
			plr.y += plr.dy
			plr.y = mid(tb, plr.y, bb)

			if collide(plr, sd, 1) then
				plr.y -= plr.dy
				plr.dy = 0
				plr.grounded = true
			end
			
			onDown(1, function() 
				plr.dx += plr.ax
			end)

			onDown(0, function()
				plr.dx -= plr.ax
			end)

			if not btn(0) or not btn(1) then
				plr.dx *= glb.fr
			end

			local lb = 0
      local rb = 128 - (plr.w * 8)

			plr.dx = mid(-plr.mdx, plr.dx, plr.mdx)
			plr.x += plr.dx
			plr.x = mid(lb, plr.x, rb)

			if collide(plr, sd, 0) then
				plr.x -= plr.dx
				plr.dx = 0
			end

			if btn(0) or btn(1) then
				plr.animState = "walk"
			else
				plr.animState = "idle"
			end

			if plr.dx < 0 then
				plr.fx = true
			end

			if plr.dx > 0 then
				plr.fx = false
			end

			if not plr.grounded then
				if plr.dy > 0 then
					plr.animState = "jumpUp"
				else 
					plr.animState = "jumpDown"
				end
			end

			local state = plr.anims[plr.animState]
			plr.animIndex = (plr.animIndex % #state.sprs) + 1
			plr.spr = state.sprs[plr.animIndex]

			trail(plr, sd)

			if collide(plr, sd, 2) then
				sfx(02)
				sceneManager.score += 1
  			local tx = flr(plr.x / 8) + sd.mapX * 16
				local ty = flr(plr.y / 8) + sd.mapY * 16
				local tw = flr((plr.x + plr.w * 8 - 1) / 8) + sd.mapX * 16
				local th = flr((plr.y + plr.h * 8 - 1) / 8) + sd.mapY * 16

				if fget(mget(tx,ty),2) then mset(tx,ty,0)
				elseif fget(mget(tw,ty),2) then mset(tw,ty,0)
				elseif fget(mget(tx,th),2) then mset(tx,th,0)
				elseif fget(mget(tw,th),2) then mset(tw,th,0)
  			end
			end

			onClick(5, function()
				sceneManager.score -= 1
				sfx(03)
				sceneManager[sceneManager.cur].init()
			end)

			if collide(plr, sd, 5) then
				sceneManager.cur = sd.next
				sceneManager[sceneManager.cur].init()
			end

			if collide(plr, sd, 4) then
				sfx(03)
				sceneManager.score -= 1
				sceneManager[sceneManager.cur].init()
			end
end

function levelDraw()
			cls(0)
			map(sd.mapX * 16,sd.mapY * 16)
			spr(plr.spr, plr.x, plr.y, plr.w, plr.h, plr.fx, plr.fy)
			print("score:"..sceneManager.score, 2, 2, 15)
end
